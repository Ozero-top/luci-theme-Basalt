{#
	luci-theme-Basalt v2

	Closes every container opened in header.ut, in reverse order:
	  .fs-content -> <footer> -> .fs-main -> .fs-shell
-#}

	{% if (!blank_page): %}
			</div>{# /.fs-content #}

			<footer class="fs-footer" role="contentinfo">
				<span>
					Powered by
					<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">{{ version.luciname }} ({{ version.luciversion }})</a>
					/
					<a href="{{ version.disturl ?? '#' }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion }}-{{ version.distrevision }}</a>
					{% if (lua_active): %}
						/ {{ _('Lua compatibility mode active') }}
					{% endif %}
				</span>
			</footer>
		</main>{# /.fs-main #}
	</div>{# /.fs-shell #}

	<script>
		var luciLocation = {{ ctx.path }};
	</script>
	<script type="text/javascript">
		/* LuCI appends env.resource_version (the luci-base version) to every
		 * module URL; it does not change when only this theme is upgraded, so
		 * a same-name menu renderer can stay pinned to a stale cached copy.
		 * Resolve the dependencies first, then add a theme-owned suffix to
		 * the cache key for this one module only. resource_version is read
		 * synchronously while require() builds the URL, so restoring it on
		 * the next line does not affect the already-issued request. */
		L.require('ui').then(function () {
			var saved = L.env.resource_version;
			L.env.resource_version = (saved ? saved + '-' : '') + 'fd2';
			L.require('menu-basalt');
			L.env.resource_version = saved;
		});
	</script>
	{% endif %}
</body>
</html>
