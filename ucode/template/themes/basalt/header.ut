{#
	luci-theme-Basalt v2

	Dark top-bar shell, vendored visually from luci-theme-footstrap
	(Apache-2.0). Structure contract: every container opened here is
	closed in footer.ut; the dispatched view is emitted between them and
	must land inside .fs-content.

	With blank_page=true only <head>, the pattern layer and the login
	form chrome render (see sysauth.ut).
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const hostname = striptags(boardinfo.hostname ?? 'OpenWrt');
	const empty_password = (getuid() == 0 && getspnam('root')?.pwdp === '');

	/* the user chip: display name from the session store, initial for the avatar */
	const fs_username = ctx.authsession
		? striptags(ubus.call('session', 'get', { ids: [ctx.authsession] })?.values?.[ctx.authsession]?.data?.username ?? 'root')
		: '';

	http.prepare_content('text/html; charset=UTF-8');

	const fs_page = entityencode(join('-', length(ctx.path) ? ctx.path : ctx.request_path), true);

	/* unsaved-changes count for the Fluent banner under the page head */
	const fs_changes = ctx.authsession ? (ubus.call('uci', 'changes') ?? {}) : {};
	let fs_change_count = 0;
	for (let cfgname, arr in (fs_changes.changes ?? {}))
		fs_change_count += length(arr ?? []);
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-layout="top" data-darkmode="false" data-theme="light" data-bs-theme="light">

<head>
	{% include("themes/" + theme + "/head_meta", { hostname: hostname, node: node }) %}

	<link rel="stylesheet" href="{{ media }}/css/cascade.css">
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif %}
	{% if (css): %}
	<style>
		{{ css }}
	</style>
	{% endif %}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/cbi.js?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/luci.js?v={{ version.luciversion }}"></script>
</head>

<!-- theme="light": iStoreOS apps (quickstart, VUM, iStore) read this Argon-established
     contract to switch their bundled palettes; Basalt is Fluent light -->
<body class="lang_{{ dispatcher.lang }}{% if (ctx.authsession): %} logged-in{% endif %}" theme="light" data-page="{{ fs_page }}">

	<div class="fs-pattern" data-fs-chrome aria-hidden="true"></div>

	{% if (!blank_page): %}
	<a class="fs-skip" data-fs-chrome href="#maincontent">{{ _('Skip to content') }}</a>

	<div class="fs-shell">
		<nav class="fs-sidebar" data-fs-chrome aria-label="{{ _('Menu') }}">
			<div class="fs-brandrow">
				<a class="fs-brand" href="{{ dispatcher.build_url() }}">
					<span class="fs-logo">
						<svg aria-hidden="true" viewBox="-9 -1 100 100"><path d="m40.5 50.8a6.6 6.6 0 1 0 0 13.2 6.6 6.6 0 0 0 0-13.2m-40.5-33.9 7 6.8a47.5 47.5 0 0 1 67.2 0l7-6.8a57.2 57.2 0 0 0-81.2 0" fill="#00b5e2"/><path d="m12.5 29.2 6.8 7a30 30 0 0 1 42.6 0l6.8-7a39.7 39.7 0 0 0-56.3 0" fill="#00b5e2"/><path d="m24.8 41.6 6.8 6.9a12.6 12.6 0 0 1 18 0l6.8-6.9a22.3 22.3 0 0 0-31.6 0" fill="#00b5e2"/><path class="fs-logo-ring" d="m64.9 39.7a30.2 30.2 0 1 1-48.7 0l-6.9-7a39.9 39.9 0 1 0 62.5 0z"/></svg>
					</span>
					<span class="fs-wordmark">{{ entityencode(hostname, true) }}</span>
				</a>
			</div>

			<div id="indicators" class="fs-indicators"></div>

			<ul class="nav" id="topmenu"></ul>
			<ul id="modemenu" class="fs-modemenu"></ul>

			<div class="fs-search" id="fs-search" data-fs-chrome>
				<button type="button" class="fs-search-field" aria-expanded="false" aria-haspopup="true" aria-controls="fs-search-panel">
					<svg class="fs-ico" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
					<span class="fs-ph">{{ _('Search settings…') }}</span>
					<kbd>Ctrl K</kbd>
				</button>
				<div class="fs-search-panel" id="fs-search-panel">
					<input type="text" class="fs-search-input" placeholder="{{ _('Type to search…') }}" aria-label="{{ _('Search settings') }}">
					<ul class="fs-search-list"></ul>
					<div class="fs-search-empty" hidden>{{ _('No results') }}</div>
				</div>
			</div>
			<span class="fs-vr" aria-hidden="true"></span>

			{% if (dispatcher.lookup("admin/logout")): %}
			<a class="fs-logout" href="{{ dispatcher.build_url('admin/logout') }}" title="{{ entityencode(_('Log out'), true) }}" aria-label="{{ entityencode(_('Log out'), true) }}">
				<span class="fs-avatar" aria-hidden="true">{{ entityencode(fs_username ? substr(fs_username, 0, 1) : 'R', true) }}</span>
				<span class="fs-who">
					<span class="fs-name">{{ entityencode(length(fs_username) ? fs_username : 'root', true) }}</span>
					<span class="fs-role">{{ _('Administrator') }}</span>
				</span>
				<svg class="fs-ico" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"/><path d="M14 12h7m0 0-3-3m3 3-3 3"/></svg>
				<span class="fs-label">{{ _('Log out') }}</span>
			</a>
			{% endif %}
		</nav>

		<main class="fs-main" id="maincontent" tabindex="-1">
			<div class="fs-title fs-sr" data-fs-chrome>
				<h1 class="fs-title-main">{{ entityencode(striptags(node?.title ? _(node.title) : hostname), true) }}</h1>
			</div>

			<div class="fs-content" data-page="{{ fs_page }}">
				{% if (empty_password): %}
				<div class="alert-message error">
					<h4>{{ _('No password set!') }}</h4>
					<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					{% if (dispatcher.lookup("admin/system/admin")): %}
					<div class="right"><a class="btn cbi-button cbi-button-action" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
					{% endif %}
				</div>
				{% endif %}

				{% if (boardinfo.rootfs_type == "initramfs"): %}
				<div class="alert-message warning">
					<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
					<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
					{% if (dispatcher.lookup("admin/system/flash")): %}
					<div class="right"><a class="btn cbi-button cbi-button-action" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
					{% endif %}
				</div>
				{% endif %}

				<noscript>
					<div class="alert-message error">
						<h4>{{ _('JavaScript required!') }}</h4>
						<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
					</div>
				</noscript>

				<div id="tabmenu" style="display:none"></div>

				{% if (fs_change_count > 0): %}
				<div class="alert-message info fs-uci-alert">
					<span class="fs-a-ico" aria-hidden="true"><svg class="fs-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 11.2V16"/><path d="M12 8.2h.01"/></svg></span>
					<div class="fs-a-body">
						<h4>{{ _('There are %d unsaved configuration changes').format(fs_change_count) }}</h4>
						<p>{{ _('Open the affected page to review the changes or apply them to make them take effect.') }}</p>
					</div>
					<button type="button" class="fs-alert-close" aria-label="{{ _('Dismiss') }}"><svg class="fs-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
				</div>
				{% endif %}
	{% endif %}
