<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ hostname }}{{ node?.title ? ` - ${striptags(node.title)}` : '' }} - LuCI</title>

<!-- Security -->
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="strict-origin-when-cross-origin">

<!-- Dark chrome: this theme is dark-only -->
<meta name="theme-color" content="#1c2128">
<meta name="darkreader-lock">

<!-- PWA / icons -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="{{ hostname }} - LuCI">
<link rel="icon" href="{{ media }}/logo_48.png" sizes="48x48">
<link rel="icon" type="image/svg+xml" href="{{ media }}/logo.svg" sizes="any">
<link rel="apple-touch-icon" href="{{ media }}/app-icon-192.png">
<link rel="manifest" href="{{ media }}/manifest.json">
